<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- Keep UDP below the 1500-byte Ethernet MTU. Fragment JPEGs in DDS,
       avoiding large IP fragment queues on the ground station. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>video_udp</transport_id><type>UDPv4</type>
      <maxMessageSize>1400</maxMessageSize>
      <sendBufferSize>1048576</sendBufferSize><receiveBufferSize>1048576</receiveBufferSize>
    </transport_descriptor>
    <transport_descriptor><transport_id>local_shm</transport_id><type>SHM</type></transport_descriptor>
  </transport_descriptors>
  <participant profile_name="robot_site" is_default_profile="true">
    <rtps><userTransports><transport_id>video_udp</transport_id><transport_id>local_shm</transport_id></userTransports><useBuiltinTransports>false</useBuiltinTransports></rtps>
  </participant>
</profiles>
